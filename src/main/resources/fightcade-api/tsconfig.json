{
  "compilerOptions": {
    /* Target & Environment */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Module Interoperability */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type Checking & Output */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}